# Copie para .env.production (VPS) ou .env.local (PC) e preencha.

# Pasta com diario.json + midias/ (fica fora do código; deploy nunca apaga)
DIARIO_DATA_DIR=/var/www/diario-data

# Senha do site (obrigatória em produção)
SITE_PASSWORD=

# Caminho do site no servidor (http://IP/diario)
NEXT_PUBLIC_BASE_PATH=/diario

# Nomes nas assinaturas e no seletor "Quem está escrevendo"
NOME_ELE=Edson
NOME_ELA=
